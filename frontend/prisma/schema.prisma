generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("CUSTOMER") // CUSTOMER, KASIR, ADMIN
  createdAt DateTime @default(now())
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  menus  Menu[]
  active Boolean @default(true)
}

model Menu {
  id           Int      @id @default(autoincrement())
  name         String
  description  String
  price        Float
  category     Category @relation(fields: [categoryId], references: [id])
  categoryId   Int
  flavor       String?  
  image        String
  stock        Int      @default(0)
  isBestSeller Boolean  @default(false)
  ratings      Rating[]
  createdAt    DateTime @default(now())
}

model Transaction {
  id           String   @id @default(uuid())
  totalPrice   Float
  customerName  String
  items         Json     
  status        String   @default("PENDING") 
  paymentMethod String?  @default("CASH") // CASH, CARDLESS
  paymentProof  String?
  createdAt    DateTime @default(now())
}

model Rating {
  id        String   @id @default(uuid())
  stars     Int      @default(5)
  comment   String?
  userId    String
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id])
  createdAt DateTime @default(now())
}
